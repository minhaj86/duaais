# SFTP connection details from the one.com Control Panel,
# under Advanced settings -> SFTP & SSH administration.
ONECOM_HOST=ssh.example.com
ONECOM_USER=example.com
ONECOM_PORT=22

# Optional. Only lftp can use it; OpenSSH sftp always prompts.
# Leave empty to be prompted instead of storing the password on disk.
ONECOM_PASSWORD=

# Web root. Older web spaces use httpd.www; newer servers use a hashed folder
# shown in Control Panel -> Subdomains under "Folder".
# To run the site under a subdirectory, append it here and in ONECOM_SITE_URL:
#   ONECOM_REMOTE_ROOT=httpd.www/wproot
ONECOM_REMOTE_ROOT=httpd.www

# Set to yes only if you cannot pre-seed the host key with:
#   ssh-keyscan -p 22 ssh.example.com >> ~/.ssh/known_hosts
ONECOM_TRUST_HOST_KEY=no

# ---------------------------------------------------------------------------
# Everything below is only read by --first-run.
# ---------------------------------------------------------------------------

# Public address of the site, used to drive the install over HTTPS.
# Include the subdirectory when there is one, for example https://example.com/wproot,
# and make sure it matches the tail of ONECOM_REMOTE_ROOT.
ONECOM_SITE_URL=https://example.com

# Database details from Control Panel -> Advanced settings -> Database settings.
# The host is never localhost; it looks like yourdomain.tld.mysql.
ONECOM_DB_NAME=
ONECOM_DB_USER=
ONECOM_DB_PASSWORD=
ONECOM_DB_HOST=example.com.mysql

# The WordPress administrator that will be created.
ONECOM_WP_ADMIN_USER=
ONECOM_WP_ADMIN_PASSWORD=
ONECOM_WP_ADMIN_EMAIL=

# Optional.
ONECOM_SITE_TITLE=Dhaka University Alumni Association In Sweden
ONECOM_WP_VERSION=latest
ONECOM_TABLE_PREFIX=wp_
